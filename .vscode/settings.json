    "statusBar.background": "#4d4fa6",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#6b6dbb",
    "titleBar.activeBackground": "#4d4fa6",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#4d4fa699",
    "titleBar.inactiveForeground": "#e7e7e799",
    "sash.hoverBorder": "#6b6dbb",
